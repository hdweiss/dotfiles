# superfile theme generated from the current Omarchy theme.
# Linked as ~/.config/superfile/theme/omarchy.toml

code_syntax_highlight = "monokai"

#-- Full Screen
full_screen_fg = "{{ foreground }}"
full_screen_bg = "{{ background }}"

#-- Gradient
gradient_color = ["{{ accent }}", "{{ magenta }}"]

#-- File Panel
file_panel_fg = "{{ foreground }}"
file_panel_bg = "{{ background }}"
file_panel_border = "{{ muted }}"
file_panel_border_active = "{{ accent }}"
file_panel_top_directory_icon = "{{ green }}"
file_panel_top_path = "{{ blue }}"
file_panel_item_selected_fg = "{{ accent }}"
file_panel_item_selected_bg = "{{ background }}"

#-- Footer
footer_fg = "{{ foreground }}"
footer_bg = "{{ background }}"
footer_border = "{{ muted }}"
footer_border_active = "{{ green }}"

#-- Sidebar
sidebar_fg = "{{ foreground }}"
sidebar_bg = "{{ background }}"
sidebar_title = "{{ cyan }}"
sidebar_border = "{{ background }}"
sidebar_border_active = "{{ red }}"
sidebar_item_selected_fg = "{{ bright_cyan }}"
sidebar_item_selected_bg = "{{ background }}"
sidebar_divider = "{{ muted }}"

#-- Modals
modal_fg = "{{ foreground }}"
modal_bg = "{{ background }}"
modal_border_active = "{{ muted }}"
modal_cancel_fg = "{{ background }}"
modal_cancel_bg = "{{ red }}"
modal_confirm_fg = "{{ background }}"
modal_confirm_bg = "{{ cyan }}"

#-- Help Menu
help_menu_hotkey = "{{ cyan }}"
help_menu_title = "{{ red }}"

#-- Special
cursor = "{{ cursor }}"
correct = "{{ green }}"
error = "{{ red }}"
hint = "{{ cyan }}"
cancel = "{{ red }}"
