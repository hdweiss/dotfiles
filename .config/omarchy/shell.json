{
  "version": 1,
  "idle": {
    "screensaver": 900,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "andreasbylund.jellyfin",
          "showBarTitle": false,
          "albumArtistsOnly": true
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "On",
          "showVinylRecord": "Off",
          "shortcutPlayer": "Omarchy Music app",
          "shortcutHints": "On",
          "showLyrics": "On",
          "showArtwork": "On",
          "showTrackTitle": "Off",
          "showArtistName": "Off",
          "showPausedTrack": "On",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "maxBarTextWidth": "240",
          "fixedBarWidth": "Off",
          "audioQuality": "320 kbps",
          "clientId": ""
        },
        {
          "id": "io.github.moizibnyousaf.omawhatsapp"
        },
        {
          "id": "omamail",
          "refreshIntervalSec": 120,
          "maxMessages": 25,
          "heavyMessageRendering": "Show plain text first",
          "contentDirection": "Auto",
          "defaultQuery": "in:inbox",
          "notifyNewMail": "Off",
          "oauthPort": 9481,
          "undoSendSeconds": 10,
          "unifiedCalendarView": true
        },
        {
          "id": "io.github.weedwhitesandwine.obsiduous"
        },
        {
          "id": "apsingh.super-productivity"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 1987,
          "clockHourCycle": 24,
          "format": "dddd HH:mm",
          "lifeExpectancy": 80,
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "io.github.ilyazar.syncthing"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "io.github.moizibnyousaf.omawhatsapp"
    }
  ]
}
