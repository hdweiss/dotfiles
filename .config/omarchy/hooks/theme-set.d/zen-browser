#!/bin/bash

# Based on bin/omarchy-theme-set-zen-browser from the fix-zen-sidebar-theme
# branch, run as a theme-set hook until that lands upstream.
#
# Local addition: live theme switching. Zen runs no code from the profile, so
# `--install` adds a Firefox AutoConfig script to the Zen installation. It
# loads a small module (embedded below) that applies
# <profile>/chrome/zen-live.css to every Zen window and re-applies it whenever
# it changes. With that in place the theme goes to zen-live.css and Zen no
# longer restarts; until then it falls back to importing the theme from
# userChrome.css, which Zen only reads at startup.
#
# AutoConfig files live next to Zen in /opt, so this needs root once. Zen
# updates leave them alone.
#   sudo zen-browser --install     add the AutoConfig files, then restart Zen
#   sudo zen-browser --uninstall   remove them
# Set ZEN_DIR to the Zen installation if it isn't in /opt or on $PATH.

ZEN_THEME_CSS="$HOME/.local/state/omarchy/current/theme/zen-browser.css"
ZEN_PROFILES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
USER_CHROME_IMPORT='@import url("omarchy.css");'

# Relative to the Zen installation.
AUTOCONFIG_PREFS=defaults/pref/zen-live-autoconfig.js
AUTOCONFIG_SCRIPT=zen-live.cfg
MODULE_DIR=zen-live

self=$(readlink -f "$0")

# === Installing into Zen ===

die() {
  echo "zen-browser: $*" >&2
  exit 1
}

# The Zen installation directory.
zen_dir() {
  local candidate binary

  [[ -n ${ZEN_DIR:-} ]] && echo "$ZEN_DIR" && return
  for candidate in /opt/zen-browser-bin /opt/zen-browser; do
    [[ -f $candidate/browser/omni.ja ]] && echo "$candidate" && return
  done
  for binary in zen-bin zen-browser zen; do
    command -v "$binary" >/dev/null || continue
    candidate=$(dirname "$(readlink -f "$(command -v "$binary")")")
    [[ -f $candidate/browser/omni.ja ]] && echo "$candidate" && return
  done
  return 1
}

zen_live_installed() {
  local dir

  dir=$(zen_dir) || return 1
  [[ -f $dir/$AUTOCONFIG_PREFS && -f $dir/$AUTOCONFIG_SCRIPT ]]
}

install_zen_live() {
  local dir other

  dir=$(zen_dir) || die "no Zen installation found"
  [[ -w $dir ]] || die "cannot write $dir, run with sudo"

  # AutoConfig takes a single script, so don't take over someone else's.
  other=$(grep -l 'general\.config\.filename' "$dir"/defaults/pref/*.js 2>/dev/null |
    grep -vx "$dir/$AUTOCONFIG_PREFS")
  [[ -z $other ]] || die "another AutoConfig is set up in $other"

  mkdir -p "$dir/defaults/pref" "$dir/$MODULE_DIR"
  write_autoconfig_prefs >"$dir/$AUTOCONFIG_PREFS"
  write_autoconfig_script >"$dir/$AUTOCONFIG_SCRIPT"
  echo "content zenlive ./" >"$dir/$MODULE_DIR/chrome.manifest"
  write_live_module >"$dir/$MODULE_DIR/ZenLive.sys.mjs"
  chmod 644 "$dir/$AUTOCONFIG_PREFS" "$dir/$AUTOCONFIG_SCRIPT" "$dir/$MODULE_DIR"/*
  echo "zen-browser: installed live theme switching into $dir, restart Zen to load it"
}

uninstall_zen_live() {
  local dir

  dir=$(zen_dir) || die "no Zen installation found"
  [[ -w $dir ]] || die "cannot write $dir, run with sudo"
  rm -rf "${dir:?}/$AUTOCONFIG_PREFS" "${dir:?}/$AUTOCONFIG_SCRIPT" "${dir:?}/$MODULE_DIR"
  echo "zen-browser: removed live theme switching from $dir, restart Zen to unload it"
}

write_autoconfig_prefs() {
  cat <<'EOF'
// Runs zen-live.cfg at startup, for live theme switching. Installed by the
// Omarchy zen-browser theme-set hook; remove it with that hook's --uninstall.
pref("general.config.filename", "zen-live.cfg");
pref("general.config.obscure_value", 0);
pref("general.config.sandbox_enabled", false);
EOF
}

# AutoConfig skips the first line. The script only registers the zen-live
# directory as chrome://zenlive/ and starts the module there, which gets the
# globals every browser module has.
write_autoconfig_script() {
  cat <<'EOF'
// zen-live.cfg: installed by the Omarchy zen-browser theme-set hook.
try {
  const manifest = Cc["@mozilla.org/file/directory_service;1"]
    .getService(Ci.nsIProperties)
    .get("GreD", Ci.nsIFile);
  manifest.append("zen-live");
  manifest.append("chrome.manifest");
  Components.manager
    .QueryInterface(Ci.nsIComponentRegistrar)
    .autoRegister(manifest);
  ChromeUtils.importESModule(
    "chrome://zenlive/content/ZenLive.sys.mjs"
  ).gZenLive.init();
} catch (e) {
  Cc["@mozilla.org/consoleservice;1"]
    .getService(Ci.nsIConsoleService)
    .logStringMessage("zen-live: " + e);
}
EOF
}

write_live_module() {
  cat <<'JS'
/**
 * Applies <profile>/chrome/zen-live.css to every Zen window as a user sheet,
 * like userChrome.css, and re-applies it whenever it or the local files it
 * @import-s change on disk. Loaded at startup by zen-live.cfg (AutoConfig).
 *
 * Imports are inlined and the result is loaded as a data: URI, so every
 * change is a new sheet the CSS loader hasn't cached. There is no file
 * watcher available to chrome code on Linux, so this polls modification
 * times.
 */

const lazy = {};

ChromeUtils.defineESModuleGetters(lazy, {
  clearInterval: "resource://gre/modules/Timer.sys.mjs",
  setInterval: "resource://gre/modules/Timer.sys.mjs",
});

const POLL_INTERVAL_MS = 1000;

// `@import url("a.css");`, `@import url(a.css);` or `@import "a.css";`,
// without media queries or layers.
const IMPORT_RE =
  /@import\s+(?:url\(\s*["']?([^"')\s]+)["']?\s*\)|["']([^"']+)["'])\s*;/g;
const URL_SCHEME_RE = /^[a-z][a-z\d+.-]*:/i;

class ZenLive {
  // data: URI of the current stylesheet, null if there is none.
  #uri = null;
  // Window -> the URI loaded into it.
  #applied = new WeakMap();
  // Path -> modification time when last read, null if missing.
  #mtimes = new Map();
  #ready = null;
  #interval = null;
  #polling = false;

  init() {
    Services.obs.addObserver(this, "domwindowopened");
    Services.obs.addObserver(this, "quit-application-granted");
  }

  observe(aSubject, aTopic) {
    if (aTopic === "quit-application-granted") {
      if (this.#interval) {
        lazy.clearInterval(this.#interval);
      }
      Services.obs.removeObserver(this, "domwindowopened");
      Services.obs.removeObserver(this, "quit-application-granted");
      return;
    }
    const win = aSubject;
    const onLoad = event => {
      if (event.target !== win.document) {
        return;
      }
      win.removeEventListener("DOMContentLoaded", onLoad);
      this.#attach(win).catch(e => console.error("[ZenLive]:", e));
    };
    win.addEventListener("DOMContentLoaded", onLoad);
  }

  async #attach(aWindow) {
    if (!aWindow.document.documentURI.startsWith("chrome:")) {
      return;
    }
    this.#ready ??= this.#start();
    await this.#ready;
    this.#applyTo(aWindow);
  }

  async #start() {
    await this.#read();
    this.#interval = lazy.setInterval(() => this.#poll(), POLL_INTERVAL_MS);
  }

  get #path() {
    return PathUtils.join(PathUtils.profileDir, "chrome", "zen-live.css");
  }

  async #read() {
    const files = new Map();
    const css = await this.#readInlined(this.#path, files);
    this.#mtimes = files;
    this.#uri = css.trim()
      ? "data:text/css;charset=utf-8," + encodeURIComponent(css)
      : null;
  }

  #applyTo(aWindow) {
    const old = this.#applied.get(aWindow) ?? null;
    if (old === this.#uri || aWindow.closed) {
      return;
    }
    const utils = aWindow.windowUtils;
    if (this.#uri) {
      utils.loadSheetUsingURIString(this.#uri, utils.USER_SHEET);
    }
    if (old) {
      utils.removeSheetUsingURIString(old, utils.USER_SHEET);
    }
    this.#applied.set(aWindow, this.#uri);
  }

  async #getModifiedTime(aPath) {
    try {
      return (await IOUtils.stat(aPath)).lastModified;
    } catch {
      return null;
    }
  }

  /**
   * Reads a stylesheet with its local @import-s inlined, recording the
   * modification time of every file read in `aFiles`.
   */
  async #readInlined(aPath, aFiles) {
    if (aFiles.has(aPath)) {
      // Already inlined, or an import cycle.
      return "";
    }
    aFiles.set(aPath, await this.#getModifiedTime(aPath));
    let contents;
    try {
      contents = await IOUtils.readUTF8(aPath);
    } catch {
      return "";
    }

    const dir = PathUtils.parent(aPath);
    let result = "";
    let last = 0;
    for (const match of contents.matchAll(IMPORT_RE)) {
      const url = match[1] ?? match[2];
      result += contents.slice(last, match.index);
      last = match.index + match[0].length;
      let importPath = null;
      if (!URL_SCHEME_RE.test(url)) {
        try {
          importPath = PathUtils.joinRelative(dir, url);
        } catch {
          // e.g. a path going up with "..".
        }
      }
      result += importPath
        ? await this.#readInlined(importPath, aFiles)
        : match[0];
    }
    return result + contents.slice(last);
  }

  async #poll() {
    if (this.#polling) {
      return;
    }
    this.#polling = true;
    try {
      for (const [path, mtime] of this.#mtimes) {
        const current = await this.#getModifiedTime(path);
        // A file going missing is most likely an editor's atomic save in
        // progress, so wait for it to come back.
        if (current !== null && current !== mtime) {
          await this.#read();
          for (const win of Services.wm.getEnumerator(null)) {
            if (this.#applied.has(win)) {
              this.#applyTo(win);
            }
          }
          break;
        }
      }
    } catch (e) {
      console.error("[ZenLive]: Error reloading zen-live.css:", e);
    } finally {
      this.#polling = false;
    }
  }
}

export const gZenLive = new ZenLive();
JS
}

case ${1:-} in
--install)
  install_zen_live
  exit
  ;;
--uninstall)
  uninstall_zen_live
  exit
  ;;
esac

# === Applying the theme ===

[[ -d $ZEN_PROFILES_DIR ]] || exit 0
[[ -f $ZEN_THEME_CSS ]] || exit 0

ensure_user_chrome_import() {
  local user_chrome_css="$1"
  local temp_file

  touch "$user_chrome_css"

  if ! grep -Fxq "$USER_CHROME_IMPORT" "$user_chrome_css"; then
    temp_file=$(mktemp)
    printf '%s\n' "$USER_CHROME_IMPORT" >"$temp_file"
    cat "$user_chrome_css" >>"$temp_file"
    mv "$temp_file" "$user_chrome_css"
  fi
}

# userChrome.css is applied after zen-live.css, so a stale import would win.
remove_user_chrome_import() {
  local user_chrome_css="$1"

  [[ -f $user_chrome_css ]] || return 0
  sed -i --follow-symlinks "\|^${USER_CHROME_IMPORT//./\\.}\$|d" "$user_chrome_css"
}

has_user_pref() {
  grep -Fxq "user_pref(\"$2\", $3);" "$1" 2>/dev/null
}

ensure_user_pref() {
  local user_js="$1"
  local pref_name="$2"
  local pref_value="$3"
  local escaped_name="${pref_name//./\\.}"

  touch "$user_js"

  if grep -q "^user_pref(\"$escaped_name\"," "$user_js"; then
    sed -i --follow-symlinks -E "s/^user_pref\(\"$escaped_name\", .*/user_pref(\"$pref_name\", $pref_value);/" "$user_js"
  else
    printf '\nuser_pref("%s", %s);\n' "$pref_name" "$pref_value" >>"$user_js"
  fi
}

# Zen polls zen-live.css for changes, so replace it whole: a half-written file
# would be applied for a moment.
write_atomically() {
  local source="$1" target="$2" temp_file

  temp_file=$(mktemp "$target.XXXXXX")
  cp "$source" "$temp_file"
  chmod 644 "$temp_file"
  mv "$temp_file" "$target"
}

restart_zen() {
  local command=""

  if omarchy-cmd-present zen-bin; then
    command="zen-bin"
  elif [[ -x /opt/zen-browser-bin/zen-bin ]]; then
    command="/opt/zen-browser-bin/zen-bin"
  elif [[ -x /opt/zen-browser/zen ]]; then
    command="/opt/zen-browser/zen"
  fi

  [[ -n $command ]] || return 0

  if pgrep -x zen >/dev/null || pgrep -x zen-bin >/dev/null; then
    # Local addition: relaunch Zen on the workspace it was on.
    source "$HOME/.config/omarchy/hooks/lib/relaunch-on-workspace.sh"
    local workspace
    workspace=$(window_workspace zen)

    pkill -x zen 2>/dev/null || true
    pkill -x zen-bin 2>/dev/null || true
    sleep 1
    relaunch_on_workspace zen "$workspace" "$command"
  fi
}

live_reload=false
needs_restart=false

if zen_live_installed; then
  live_reload=true
elif zen_dir >/dev/null; then
  notify-send -a Zen "Zen restarts on every theme switch" \
    "For live theme switching, run once: sudo ~/.config/omarchy/hooks/theme-set.d/zen-browser --install" \
    2>/dev/null || true
fi

for profile_dir in "$ZEN_PROFILES_DIR"/*; do
  [[ -d $profile_dir ]] || continue
  [[ -f $profile_dir/prefs.js || -f $profile_dir/user.js ]] || continue

  chrome_dir="$profile_dir/chrome"
  user_js="$profile_dir/user.js"
  mkdir -p "$chrome_dir"

  has_user_pref "$user_js" "zen.theme.content-element-separation" "0" || needs_restart=true
  ensure_user_pref "$user_js" "zen.theme.content-element-separation" "0"

  if $live_reload; then
    write_atomically "$ZEN_THEME_CSS" "$chrome_dir/zen-live.css"
    remove_user_chrome_import "$chrome_dir/userChrome.css"
    rm -f "$chrome_dir/omarchy.css"
  else
    needs_restart=true
    ensure_user_chrome_import "$chrome_dir/userChrome.css"
    ensure_user_pref "$user_js" "toolkit.legacyUserProfileCustomizations.stylesheets" "true"
    rm -f "$chrome_dir/zen-live.css"
    cp "$ZEN_THEME_CSS" "$chrome_dir/omarchy.css"
  fi
done

$needs_restart && restart_zen
exit 0
