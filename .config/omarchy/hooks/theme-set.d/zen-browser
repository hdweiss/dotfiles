#!/bin/bash

# Based on bin/omarchy-theme-set-zen-browser from the fix-zen-sidebar-theme
# branch, run as a theme-set hook until that lands upstream.
#
# Local addition: live theme switching. Zen runs no code from the profile, but
# it loads unsigned extensions, and those may use privileged experiment APIs.
# So this hook keeps a small extension (zen-live@omarchy, written below) in
# ~/.local/share and points every Zen profile at it. The extension applies
# <profile>/chrome/zen-live.css to every Zen window and re-applies it whenever
# it changes, so the theme goes there and Zen no longer restarts.
#
# Zen loads the extension at its next start, so the first theme switch restarts
# Zen once. If the extension doesn't load, the theme falls back to an import in
# userChrome.css, which Zen only reads at startup, and Zen restarts each time.
#
# To remove the extension: delete <profile>/extensions/zen-live@omarchy and
# ~/.local/share/zen-live-extension, then restart Zen.

ZEN_THEME_CSS="$HOME/.local/state/omarchy/current/theme/zen-browser.css"
ZEN_PROFILES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
USER_CHROME_IMPORT='@import url("omarchy.css");'

EXTENSION_ID=zen-live@omarchy
EXTENSION_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zen-live-extension"

[[ -d $ZEN_PROFILES_DIR ]] || exit 0
[[ -f $ZEN_THEME_CSS ]] || exit 0

# === The extension ===

write_extension_api() {
  cat <<'JS'
/**
 * Applies <profile>/chrome/zen-live.css to every Zen window as a user sheet,
 * like userChrome.css, and re-applies it whenever it or the local files it
 * @import-s change on disk.
 *
 * This is an experiment API that only uses the "startup" event, so it runs
 * with chrome privileges as soon as Zen starts the extension. Imports are
 * inlined and the result is loaded as a data: URI, so every change is a new
 * sheet the CSS loader hasn't cached. There is no file watcher available to
 * chrome code on Linux, so this polls modification times.
 */

/* global ExtensionAPI, ChromeUtils, IOUtils, PathUtils, Services */

var { clearInterval, setInterval } = ChromeUtils.importESModule(
  "resource://gre/modules/Timer.sys.mjs"
);

var POLL_INTERVAL_MS = 1000;

// `@import url("a.css");`, `@import url(a.css);` or `@import "a.css";`,
// without media queries or layers.
var IMPORT_RE =
  /@import\s+(?:url\(\s*["']?([^"')\s]+)["']?\s*\)|["']([^"']+)["'])\s*;/g;
var URL_SCHEME_RE = /^[a-z][a-z\d+.-]*:/i;

class ZenLive {
  // data: URI of the current stylesheet, null if there is none.
  #uri = null;
  // Window -> the URI loaded into it.
  #applied = new WeakMap();
  // Path -> modification time when last read, null if missing.
  #mtimes = new Map();
  #ready = null;
  #interval = null;
  #polling = false;
  #stopped = false;

  start() {
    Services.obs.addObserver(this, "domwindowopened");
    for (const win of Services.wm.getEnumerator(null)) {
      if (
        win.document.readyState === "loading" ||
        win.document.documentURI === "about:blank"
      ) {
        this.#attachWhenLoaded(win);
      } else {
        this.#attach(win);
      }
    }
  }

  stop() {
    this.#stopped = true;
    Services.obs.removeObserver(this, "domwindowopened");
    if (this.#interval) {
      clearInterval(this.#interval);
    }
    this.#uri = null;
    this.#applyToAll();
  }

  observe(aSubject) {
    this.#attachWhenLoaded(aSubject);
  }

  #attachWhenLoaded(aWindow) {
    const onLoad = event => {
      if (event.target !== aWindow.document) {
        return;
      }
      aWindow.removeEventListener("DOMContentLoaded", onLoad);
      this.#attach(aWindow);
    };
    aWindow.addEventListener("DOMContentLoaded", onLoad);
  }

  async #attach(aWindow) {
    try {
      if (!aWindow.document.documentURI.startsWith("chrome:")) {
        return;
      }
      this.#ready ??= this.#begin();
      await this.#ready;
      if (!this.#stopped) {
        this.#applyTo(aWindow);
      }
    } catch (e) {
      console.error("[ZenLive]:", e);
    }
  }

  async #begin() {
    await this.#read();
    if (!this.#stopped) {
      this.#interval = setInterval(() => this.#poll(), POLL_INTERVAL_MS);
    }
  }

  get #path() {
    return PathUtils.join(PathUtils.profileDir, "chrome", "zen-live.css");
  }

  async #read() {
    const files = new Map();
    const css = await this.#readInlined(this.#path, files);
    this.#mtimes = files;
    this.#uri = css.trim()
      ? "data:text/css;charset=utf-8," + encodeURIComponent(css)
      : null;
  }

  #applyTo(aWindow) {
    const old = this.#applied.get(aWindow) ?? null;
    if (old === this.#uri || aWindow.closed) {
      return;
    }
    const utils = aWindow.windowUtils;
    if (this.#uri) {
      utils.loadSheetUsingURIString(this.#uri, utils.USER_SHEET);
    }
    if (old) {
      utils.removeSheetUsingURIString(old, utils.USER_SHEET);
    }
    this.#applied.set(aWindow, this.#uri);
  }

  #applyToAll() {
    for (const win of Services.wm.getEnumerator(null)) {
      if (this.#applied.has(win)) {
        this.#applyTo(win);
      }
    }
  }

  async #getModifiedTime(aPath) {
    try {
      return (await IOUtils.stat(aPath)).lastModified;
    } catch {
      return null;
    }
  }

  /**
   * Reads a stylesheet with its local @import-s inlined, recording the
   * modification time of every file read in `aFiles`.
   */
  async #readInlined(aPath, aFiles) {
    if (aFiles.has(aPath)) {
      // Already inlined, or an import cycle.
      return "";
    }
    aFiles.set(aPath, await this.#getModifiedTime(aPath));
    let contents;
    try {
      contents = await IOUtils.readUTF8(aPath);
    } catch {
      return "";
    }

    const dir = PathUtils.parent(aPath);
    let result = "";
    let last = 0;
    for (const match of contents.matchAll(IMPORT_RE)) {
      const url = match[1] ?? match[2];
      result += contents.slice(last, match.index);
      last = match.index + match[0].length;
      let importPath = null;
      if (!URL_SCHEME_RE.test(url)) {
        try {
          importPath = PathUtils.joinRelative(dir, url);
        } catch {
          // e.g. a path going up with "..".
        }
      }
      result += importPath
        ? await this.#readInlined(importPath, aFiles)
        : match[0];
    }
    return result + contents.slice(last);
  }

  async #poll() {
    if (this.#polling) {
      return;
    }
    this.#polling = true;
    try {
      for (const [path, mtime] of this.#mtimes) {
        const current = await this.#getModifiedTime(path);
        // A file going missing is most likely an editor's atomic save in
        // progress, so wait for it to come back.
        if (current !== null && current !== mtime) {
          await this.#read();
          if (!this.#stopped) {
            this.#applyToAll();
          }
          break;
        }
      }
    } catch (e) {
      console.error("[ZenLive]: Error reloading zen-live.css:", e);
    } finally {
      this.#polling = false;
    }
  }
}

this.zenLive = class extends ExtensionAPI {
  onStartup() {
    this.live = new ZenLive();
    this.live.start();
  }

  onShutdown() {
    this.live?.stop();
  }

  getAPI() {
    return { zenLive: {} };
  }
};
JS
}

write_extension_manifest() {
  cat <<EOF
{
  "manifest_version": 2,
  "name": "Omarchy live theme",
  "version": "$1",
  "description": "Applies the Omarchy theme to Zen as it changes. Managed by the Omarchy zen-browser theme-set hook.",
  "browser_specific_settings": {
    "gecko": { "id": "$EXTENSION_ID" }
  },
  "experiment_apis": {
    "zenLive": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["zenLive"]],
        "script": "api.js",
        "events": ["startup"]
      }
    }
  }
}
EOF
}

# Rewrites the extension only when it changed: Zen picks up a change at its
# next start by the manifest, whose version follows the code.
ensure_extension() {
  local temp_dir version

  temp_dir=$(mktemp -d)
  write_extension_api >"$temp_dir/api.js"
  echo '[{ "namespace": "zenLive", "functions": [] }]' >"$temp_dir/schema.json"
  version="1.0.$(cksum <"$temp_dir/api.js" | cut -d' ' -f1)"
  write_extension_manifest "$version" >"$temp_dir/manifest.json"

  if diff -rq "$temp_dir" "$EXTENSION_DIR" >/dev/null 2>&1; then
    rm -rf "$temp_dir"
  else
    rm -rf "$EXTENSION_DIR"
    mkdir -p "$(dirname "$EXTENSION_DIR")"
    mv "$temp_dir" "$EXTENSION_DIR"
    chmod 755 "$EXTENSION_DIR"
  fi
}

# Whether Zen has loaded the extension in this profile, as recorded in
# extensions.json: "active", "inactive" (seen but not loaded) or "unknown".
extension_state() {
  local state

  state=$(jq -r --arg id "$EXTENSION_ID" \
    'first(.addons[] | select(.id == $id) | if .active then "active" else "inactive" end) // "unknown"' \
    "$1/extensions.json" 2>/dev/null)
  echo "${state:-unknown}"
}

# === The profile ===

ensure_user_chrome_import() {
  local user_chrome_css="$1"
  local temp_file

  touch "$user_chrome_css"

  if ! grep -Fxq "$USER_CHROME_IMPORT" "$user_chrome_css"; then
    temp_file=$(mktemp)
    printf '%s\n' "$USER_CHROME_IMPORT" >"$temp_file"
    cat "$user_chrome_css" >>"$temp_file"
    mv "$temp_file" "$user_chrome_css"
  fi
}

# Returns 0 if there was an import to remove. Zen has that file loaded until
# it restarts, and userChrome.css may override zen-live.css.
remove_user_chrome_import() {
  local user_chrome_css="$1"

  grep -Fxq "$USER_CHROME_IMPORT" "$user_chrome_css" 2>/dev/null || return 1
  sed -i --follow-symlinks "\|^${USER_CHROME_IMPORT//./\\.}\$|d" "$user_chrome_css"
}

has_user_pref() {
  grep -Fxq "user_pref(\"$2\", $3);" "$1" 2>/dev/null
}

ensure_user_pref() {
  local user_js="$1"
  local pref_name="$2"
  local pref_value="$3"
  local escaped_name="${pref_name//./\\.}"

  touch "$user_js"

  if grep -q "^user_pref(\"$escaped_name\"," "$user_js"; then
    sed -i --follow-symlinks -E "s/^user_pref\(\"$escaped_name\", .*/user_pref(\"$pref_name\", $pref_value);/" "$user_js"
  else
    printf '\nuser_pref("%s", %s);\n' "$pref_name" "$pref_value" >>"$user_js"
  fi
}

# Zen polls zen-live.css for changes, so replace it whole: a half-written file
# would be applied for a moment.
write_atomically() {
  local source="$1" target="$2" temp_file

  temp_file=$(mktemp "$target.XXXXXX")
  cp "$source" "$temp_file"
  chmod 644 "$temp_file"
  mv "$temp_file" "$target"
}

restart_zen() {
  local command=""

  if omarchy-cmd-present zen-bin; then
    command="zen-bin"
  elif [[ -x /opt/zen-browser-bin/zen-bin ]]; then
    command="/opt/zen-browser-bin/zen-bin"
  elif [[ -x /opt/zen-browser/zen ]]; then
    command="/opt/zen-browser/zen"
  fi

  [[ -n $command ]] || return 0

  if pgrep -x zen >/dev/null || pgrep -x zen-bin >/dev/null; then
    # Local addition: relaunch Zen on the workspace it was on.
    source "$HOME/.config/omarchy/hooks/lib/relaunch-on-workspace.sh"
    local workspace
    workspace=$(window_workspace zen)

    pkill -x zen 2>/dev/null || true
    pkill -x zen-bin 2>/dev/null || true
    sleep 1
    relaunch_on_workspace zen "$workspace" "$command"
  fi
}

ensure_extension
needs_restart=false

for profile_dir in "$ZEN_PROFILES_DIR"/*; do
  [[ -d $profile_dir ]] || continue
  [[ -f $profile_dir/prefs.js || -f $profile_dir/user.js ]] || continue

  chrome_dir="$profile_dir/chrome"
  user_js="$profile_dir/user.js"
  mkdir -p "$chrome_dir" "$profile_dir/extensions"

  # Zen reads user.js and looks for new extensions only at startup.
  #   signatures.required: load the extension, which is unsigned
  #   experiments.enabled: let it use privileged APIs (the default in Zen)
  #   startupScanScopes/autoDisableScopes: pick up extensions added to the
  #     profile folder at startup, enabled without asking
  #   content-element-separation: part of the theme
  for pref in \
    "xpinstall.signatures.required false" \
    "extensions.experiments.enabled true" \
    "extensions.startupScanScopes 1" \
    "extensions.autoDisableScopes 14" \
    "zen.theme.content-element-separation 0"; do
    read -r pref_name pref_value <<<"$pref"
    has_user_pref "$user_js" "$pref_name" "$pref_value" || needs_restart=true
    ensure_user_pref "$user_js" "$pref_name" "$pref_value"
  done

  pointer="$profile_dir/extensions/$EXTENSION_ID"
  if [[ $(cat "$pointer" 2>/dev/null) != "$EXTENSION_DIR" ]]; then
    printf '%s\n' "$EXTENSION_DIR" >"$pointer"
    needs_restart=true
  fi

  write_atomically "$ZEN_THEME_CSS" "$chrome_dir/zen-live.css"

  if [[ $(extension_state "$profile_dir") == inactive ]]; then
    # Zen saw the extension but didn't load it, so theme it at startup.
    needs_restart=true
    ensure_user_chrome_import "$chrome_dir/userChrome.css"
    ensure_user_pref "$user_js" "toolkit.legacyUserProfileCustomizations.stylesheets" "true"
    cp "$ZEN_THEME_CSS" "$chrome_dir/omarchy.css"
  else
    remove_user_chrome_import "$chrome_dir/userChrome.css" && needs_restart=true
    rm -f "$chrome_dir/omarchy.css"
  fi
done

if $needs_restart; then
  restart_zen
fi
exit 0
