{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "disableRemoteControl": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowRead": [
        "~/.local/share/mise",
        "~/.config/mise",
        "~/.local/state/mise"
      ]
    }
  },
  "spinnerTipsEnabled": false,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "custom:omarchy",
  "voiceEnabled": false
}
